{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://u1-planner.local/schemas/material-catalog.v1.json",
  "title": "U1 Planner Material Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogId", "source", "disclaimer", "spools"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "catalogId": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrievedOn"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "retrievedOn": { "type": "string", "format": "date" }
      }
    },
    "disclaimer": { "type": "string", "minLength": 1 },
    "spools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "manufacturer",
          "product",
          "colorName",
          "hex",
          "material",
          "colorBasis",
          "defaultRole",
          "mixingPolicy",
          "sourceUrl"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "manufacturer": { "type": "string", "minLength": 1 },
          "product": { "type": "string", "minLength": 1 },
          "colorName": { "type": "string", "minLength": 1 },
          "hex": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "material": { "enum": ["PLA", "PETG"] },
          "colorBasis": { "enum": ["nominal", "measured"] },
          "defaultRole": {
            "enum": ["fixed_cyan", "fixed_magenta", "fixed_yellow", "default_t4", "optional"]
          },
          "mixingPolicy": {
            "enum": ["fixed_component", "full_spectrum", "solid_only_until_calibrated"]
          },
          "sourceUrl": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
