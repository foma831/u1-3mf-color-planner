{
  "name": "u1-3mf-color-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run tauri:dev --workspace @u1-planner/desktop",
    "build": "npm run tauri:build --workspace @u1-planner/desktop",
    "build:web": "npm run build:web --workspace @u1-planner/desktop",
    "check": "npm run check --workspace @u1-planner/desktop",
    "test": "npm run test --workspace @u1-planner/desktop",
    "test:rust": "cargo test --workspace --all-targets --locked && cargo test --workspace --doc --locked",
    "check:rust": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "verify": "npm test && npm run check && npm run build:web && npm run check:rust && npm run test:rust"
  },
  "engines": {
    "node": ">=22"
  }
}
